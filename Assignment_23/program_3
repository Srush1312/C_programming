/*
    Enter string: Marvellous Multi OS
    Modified string is mARVELLOUS mULTI os
*/

#include <stdio.h>

void strlwrx(char *str)
{
    int i = 0;

    while(str[i] != '\0')
    {
        if(str[i] >= 'A' && str[i] <= 'Z')
        {
            str[i] = str[i] + 32;
        }
        else if(str[i] >= 'a' && str[i] <= 'z')
        {
            str[i] = str[i] - 32;
        }
        i++;
    }
}

int main()
{
    char arr[30];

    printf("Enter string: ");
    scanf("%29[^\n]", arr);

    strlwrx(arr);

    printf("Modified string is %s", arr);

    return 0;
}