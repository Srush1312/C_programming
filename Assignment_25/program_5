/*  
    Display exam schedule according to division
    Division A  7:00 AM
    Division B  8:30 AM
    Division C  9:20 AM
    Division D  10:30 AM
    The program accepts both uppercase and lowercase division characters.

    Enter your division: C
    Your exam at 9.20 AM

    Enter your division: d
    Your exam at 10.30 AM
*/    

#include<stdio.h>

void DisplaySchedule(char chDiv)
{
    switch (chDiv)
    {
        case 'A':
        case 'a':
            printf("Your exam at 7 AM");
            break;

        case 'B':
        case 'b':
            printf("Your exam at 8.30 AM");
            break;

        case 'C':
        case 'c':
            printf("Your exam at 9.20 AM");
            break;

        case 'D':
        case 'd':
            printf("Your exam at 10.30 AM");
            break;

        default:
            printf("Invalid Division");
    }
}

int main()
{
    char cValue = '\0';

    printf("Enter your division: ");
    scanf("%c", &cValue);

    DisplaySchedule(cValue);

    return 0;
}
