/*
    Convert lowercase to uppercase and uppercase to lowercase
    If the character is uppercase (A-Z), convert it to lowercase.
    If the character is lowercase (a-z), convert it to uppercase.
    Otherwise, display the character as it is.

    Enter the character: Q
    Output: q

    Enter the character: m
    Output: M

    Enter the character: 4
    Output: 4
*/

#include <stdio.h>

void Display(char ch)
{
    if (ch >= 'A' && ch <= 'Z')
    {
        ch = ch + 32;
    }
    else if (ch >= 'a' && ch <= 'z')
    {
        ch = ch - 32;
    }

    printf("Output: %c\n", ch);
}

int main()
{
    char cValue = '\0';

    printf("Enter the character: ");
    scanf("%c", &cValue);

    Display(cValue);

    return 0;
}
